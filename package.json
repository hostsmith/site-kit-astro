{
  "name": "site-kit-astro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/site-kit-astro",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check:urls": "npm run check:urls --workspaces --if-present",
    "test": "node --test --test-concurrency=4 \"tests/*.test.mjs\"",
    "test:browser": "node --test --test-concurrency=2 \"tests/browser/*.test.mjs\""
  },
  "devDependencies": {
    "playwright": "1.64.0"
  }
}
