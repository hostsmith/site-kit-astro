---
// Example page template (site-kit-locales design D53): the kit renders the
// `template: custom` page entry `about` with it, in every locale that has the
// page. A custom page has no props of its own, so its content is in its
// sections, which an owner edits in the CMS. This template shows the first
// one, a hero, in the site's own markup, and the rest as the kit renders
// them. Every rendered value carries its field attribute. The header is the
// site's own markup, so it's styled with utilities on the theme's tokens; the
// sections after it are the kit's, which the theme styles.
import Sections from "@hostsmith/site-kit-astro/components/Sections.astro";
import { customPage } from "@hostsmith/site-kit-astro/custom-page";
import { sectionFields } from "@hostsmith/site-kit-astro/field";
import Base from "@hostsmith/site-kit-astro/layouts/Base.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"pages">;
  locale?: string;
  path: string;
}

const { entry, locale, path } = Astro.props;
const { ref, data } = await customPage(entry);
const [first, ...sections] = data.sections ?? [];
if (first?.type !== "hero") {
  throw new Error(`${entry.filePath}: the about page's template shows its first section as the page header, so that section is a hero.`);
}
const hero = first as { id: string; type: "hero"; eyebrow?: string; title: string; image?: string; imageAlt?: string };
const f = sectionFields(ref, hero);
---

<Base title={data.title} description={data.description} image={data.ogImage} path={path} locale={locale}>
  <header class="mx-auto max-w-site px-gutter pt-section">
    {hero.eyebrow && <p class="text-eyebrow text-brand uppercase" {...f.field("eyebrow")}>{hero.eyebrow}</p>}
    <h1 class="mt-4 max-w-prose font-heading text-h1" {...f.field("title")}>{hero.title}</h1>
    {
      hero.image && (
        <img src={hero.image} alt={hero.imageAlt} class="mt-10 h-72 w-full rounded-panel bg-tint object-cover md:h-120" {...f.field("image")} />
      )
    }
  </header>
  <Sections entry={ref} title={data.title} sections={sections} hasH1 />
</Base>
