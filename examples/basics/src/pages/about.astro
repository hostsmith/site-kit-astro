---
// Example `template: custom` page. It reads its own page entry
// (src/content/pages/about.md), declares the props it adds, and gives every
// rendered value a field attribute. Its header is the site's own markup, so
// it's styled with utilities on the theme's tokens; the sections after it are
// the kit's, which the theme styles.
import Sections from "@hostsmith/site-kit-astro/components/Sections.astro";
import { customPage } from "@hostsmith/site-kit-astro/custom-page";
import { field } from "@hostsmith/site-kit-astro/field";
import Base from "@hostsmith/site-kit-astro/layouts/Base.astro";
import { pagePath } from "@hostsmith/site-kit-astro/routes";
import { mediaPath } from "@hostsmith/site-kit-astro/schema";
import { z } from "astro/zod";

const { entry, ref, data } = await customPage("about", {
  eyebrow: z.string().min(1),
  heading: z.string().min(1),
  image: mediaPath,
  imageAlt: z.string().min(1),
});
---

<Base title={data.title} description={data.description} image={data.ogImage} path={pagePath(entry.id)}>
  <header class="mx-auto max-w-site px-gutter pt-section">
    <p class="text-eyebrow text-brand uppercase" {...field(ref, "eyebrow")}>{data.eyebrow}</p>
    <h1 class="mt-4 max-w-prose font-heading text-h1" {...field(ref, "heading")}>{data.heading}</h1>
    <img
      src={data.image}
      alt={data.imageAlt}
      class="mt-10 h-72 w-full rounded-panel bg-tint object-cover md:h-120"
      {...field(ref, "image")}
    />
  </header>
  {data.sections && <Sections entry={ref} title={data.title} sections={data.sections} hasH1 />}
</Base>
