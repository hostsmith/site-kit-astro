---
// hero: eyebrow, badge, title, subtitle, image + imageAlt, cta,
// secondaryCta, note. Variants: centered (default), image-left, image-right,
// background, page. The first hero on a page renders its title as h1
// (`primary`), later ones as h2.
//
// The text comes first in reading order in every variant. The variant's
// modifier class tells the theme where the image goes: beside the text, behind
// it, or below it at full width (`page`, a page header).
import type { Section } from "../../kit-content.ts";
import { sectionFields } from "../../core/field.ts";
import { sectionClass } from "../../lib/hooks.ts";

interface Props {
  section: Extract<Section, { type: "hero" }>;
  entry: string;
  primary: boolean;
}

const { section, entry, primary } = Astro.props;
const { eyebrow, badge, title, subtitle, image, imageAlt, cta, secondaryCta, note } = section;
const f = sectionFields(entry, section);
const Heading = primary ? "h1" : "h2";
---

<section {...f.root} class={sectionClass(section)}>
  <div class="sk-container">
    <div class="sk-hero__content">
      {
        badge && (
          <p class="sk-hero__badge" {...f.field("badge")}>
            {badge}
          </p>
        )
      }
      {
        eyebrow && (
          <p class="sk-eyebrow" {...f.field("eyebrow")}>
            {eyebrow}
          </p>
        )
      }
      <Heading class="sk-hero__title" {...f.field("title")}>{title}</Heading>
      {
        subtitle && (
          <p class="sk-hero__subtitle" {...f.field("subtitle")}>
            {subtitle}
          </p>
        )
      }
      {
        (cta || secondaryCta) && (
          <div class="sk-buttons">
            {cta && (
              <a href={cta.link} class="sk-button sk-button--primary" {...f.field("cta", "label")}>
                {cta.label}
              </a>
            )}
            {secondaryCta && (
              <a href={secondaryCta.link} class="sk-button sk-button--secondary" {...f.field("secondaryCta", "label")}>
                {secondaryCta.label}
              </a>
            )}
          </div>
        )
      }
      {
        note && (
          <p class="sk-hero__note" {...f.field("note")}>
            {note}
          </p>
        )
      }
    </div>
    {image && <img src={image} alt={imageAlt} class="sk-hero__media" {...f.field("image")} />}
  </div>
</section>
