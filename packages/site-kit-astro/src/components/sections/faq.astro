---
// faq: title, items (question, answer). No variants. Each item is a native
// <details> with the question as its <summary>, so it opens and closes with
// Enter or Space and needs no script. Answers are markdown.
import type { Section } from "../../kit-content.ts";
import { sectionFields } from "../../lib/field.ts";
import { sectionClass } from "../../lib/hooks.ts";
import { renderMarkdown } from "../../lib/markdown.ts";

interface Props {
  section: Extract<Section, { type: "faq" }>;
  entry: string;
  primary: boolean;
}

const { section, entry } = Astro.props;
const { title, items } = section;
const f = sectionFields(entry, section);
const answers = await Promise.all(
  items.map((item, i) => renderMarkdown(item.answer, `${entry} section "${section.id}" (faq) items[${i}].answer`)),
);
---

<section {...f.root} class={sectionClass(section)}>
  <div class="sk-container">
    {
      title && (
        <div class="sk-section__header">
          <h2 class="sk-section__title" {...f.field("title")}>
            {title}
          </h2>
        </div>
      )
    }
    <div class="sk-faq__list">
      {
        items.map((item, i) => (
          <details class="sk-faq__item">
            <summary class="sk-faq__question" {...f.field("items", i, "question")}>
              {item.question}
            </summary>
            <div class="sk-faq__answer sk-prose" {...f.field("items", i, "answer")} set:html={answers[i]} />
          </details>
        ))
      }
    </div>
  </div>
</section>
