---
// collection-list: title, collection, limit, link. Variants: cards (default),
// list, featured. Lists the collection's non-draft entries, newest first, each
// linked to its detail page. A card shows the entry's image, category, title,
// date and description when the entry has them. `featured` marks the first
// card, which a theme shows larger. In a localized site, it lists the entries
// in its own page's locale.
import type { Section } from "../../kit-content.ts";
import { field, sectionFields } from "../../lib/field.ts";
import { sectionClass } from "../../lib/hooks.ts";
import { getEntryRoutes } from "../../lib/routes.ts";
import { getSettings, settingsRef } from "../../lib/settings.ts";
import { localeOfRef } from "../../lib/site-locales.ts";
import SectionHeader from "../SectionHeader.astro";

interface Props {
  section: Extract<Section, { type: "collection-list" }>;
  entry: string;
  primary: boolean;
}

interface CardData {
  title: string;
  date?: string;
  category?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const { section, entry } = Astro.props;
const f = sectionFields(entry, section);
const locale = localeOfRef(entry)?.code;
const settings = await getSettings(locale);
const SETTINGS = settingsRef(locale);
const collection = section.collection.name;
const routes = await getEntryRoutes(collection, locale);
const items = section.limit === undefined ? routes : routes.slice(0, section.limit);
const dateFormat = new Intl.DateTimeFormat(settings.language, { dateStyle: "long", timeZone: "UTC" });
const featured = section.variant === "featured";
---

<section {...f.root} class={sectionClass(section)}>
  <div class="sk-container">
    <SectionHeader field={f.field} title={section.title} link={section.link} />
    <ul class="sk-collection-list__list">
      {
        items.map(({ path, key, entry: item }, i) => {
          const data = item.data as CardData;
          const ref = `${collection}/${item.id}`;
          // By the entry's id within its locale, which the list shares.
          const titleId = `${section.id}-${key.replaceAll("/", "-")}`;
          return (
            <li class:list={["sk-card", "sk-card--linked", featured && i === 0 && "sk-card--featured"]}>
              {data.image && <img src={data.image} alt={data.imageAlt} class="sk-card__media" {...field(ref, "image")} />}
              <div class="sk-card__body">
                {data.category && (
                  <p class="sk-card__category" {...field(ref, "category")}>
                    {data.category}
                  </p>
                )}
                <h3 id={titleId} class="sk-card__title">
                  <a href={path} {...field(ref, "title")}>
                    {data.title}
                  </a>
                </h3>
                {data.date && (
                  <time datetime={data.date} class="sk-card__meta" {...field(ref, "date")}>
                    {dateFormat.format(new Date(data.date))}
                  </time>
                )}
                {data.description && (
                  <p class="sk-card__text" {...field(ref, "description")}>
                    {data.description}
                  </p>
                )}
                <a href={path} aria-describedby={titleId} class="sk-card__more" {...field(SETTINGS, "ui", "readMore")}>
                  {settings.ui.readMore}
                </a>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
