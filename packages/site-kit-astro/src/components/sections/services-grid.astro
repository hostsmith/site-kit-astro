---
// services-grid: eyebrow, title, intro, link, items (title, text, icon,
// image + imageAlt, link). Variants: cards (default), list. Tones: plain
// (default), surface. An item with a link renders its title as the link and
// gets `sk-card--linked`, so a theme can stretch the link over the card.
import type { Section } from "../../kit-content.ts";
import { sectionFields } from "../../core/field.ts";
import { sectionClass } from "../../lib/hooks.ts";
import Icon from "../Icon.astro";
import SectionHeader from "../SectionHeader.astro";

interface Props {
  section: Extract<Section, { type: "services-grid" }>;
  entry: string;
  primary: boolean;
}

const { section, entry } = Astro.props;
const { eyebrow, title, intro, link, items } = section;
const f = sectionFields(entry, section);
---

<section {...f.root} class={sectionClass(section)}>
  <div class="sk-container">
    <SectionHeader field={f.field} eyebrow={eyebrow} title={title} intro={intro} link={link} />
    <ul class="sk-services-grid__list">
      {
        items.map((item, i) => (
          <li class:list={["sk-card", item.link && "sk-card--linked"]}>
            {item.image && <img src={item.image} alt={item.imageAlt} class="sk-card__media" {...f.field("items", i, "image")} />}
            <div class="sk-card__body">
              {item.icon && (
                <span class="sk-card__icon">
                  <Icon name={item.icon} />
                </span>
              )}
              {item.link ? (
                <h3 class="sk-card__title">
                  <a href={item.link} {...f.field("items", i, "title")}>
                    {item.title}
                  </a>
                </h3>
              ) : (
                <h3 class="sk-card__title" {...f.field("items", i, "title")}>
                  {item.title}
                </h3>
              )}
              {item.text && (
                <p class="sk-card__text" {...f.field("items", i, "text")}>
                  {item.text}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
