---
// hours-location: title, address, hours (days, time), phone, email, note,
// mapLink. No variants. The phone number and email address show as links. It
// links to a map and never embeds one: an embed would load the map
// provider's scripts and send visitor data to it.
import type { Section } from "../../kit-content.ts";
import { sectionFields } from "../../core/field.ts";
import { sectionClass } from "../../lib/hooks.ts";
import { telHref } from "../../lib/tel.ts";
import Icon from "../Icon.astro";
import Lines from "../Lines.astro";

interface Props {
  section: Extract<Section, { type: "hours-location" }>;
  entry: string;
  primary: boolean;
}

const { section, entry } = Astro.props;
const { title, address, hours, phone, email, note, mapLink } = section;
const f = sectionFields(entry, section);
---

<section {...f.root} class={sectionClass(section)}>
  <div class="sk-container">
    {
      title && (
        <div class="sk-section__header">
          <h2 class="sk-section__title" {...f.field("title")}>
            {title}
          </h2>
        </div>
      )
    }
    {
      (phone || email) && (
        <div class="sk-hours-location__contact">
          {phone && (
            <a href={telHref(phone)} class="sk-hours-location__contact-link" {...f.field("phone")}>
              <Icon name="phone" />
              {phone}
            </a>
          )}
          {email && (
            <a href={`mailto:${email}`} class="sk-hours-location__contact-link" {...f.field("email")}>
              <Icon name="mail" />
              {email}
            </a>
          )}
        </div>
      )
    }
    {
      (address || mapLink) && (
        <div class="sk-hours-location__place">
          {address && (
            <address class="sk-hours-location__address" {...f.field("address")}>
              <Lines text={address} />
            </address>
          )}
          {mapLink && (
            <a href={mapLink.link} class="sk-hours-location__map-link" {...f.field("mapLink", "label")}>
              {mapLink.label}
            </a>
          )}
        </div>
      )
    }
    {
      hours && (
        <dl class="sk-hours-location__hours">
          {hours.map((row, i) => (
            <div class="sk-hours-location__row">
              <dt class="sk-hours-location__days" {...f.field("hours", i, "days")}>
                {row.days}
              </dt>
              <dd class="sk-hours-location__time" {...f.field("hours", i, "time")}>
                {row.time}
              </dd>
            </div>
          ))}
        </dl>
      )
    }
    {
      note && (
        <p class="sk-hours-location__note" {...f.field("note")}>
          {note}
        </p>
      )
    }
  </div>
</section>
