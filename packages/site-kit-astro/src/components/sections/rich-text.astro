---
// rich-text: title and a markdown body. Variants: narrow (default), wide.
import type { Section } from "../../kit-content.ts";
import { sectionFields } from "../../core/field.ts";
import { sectionClass } from "../../lib/hooks.ts";
import { renderMarkdown } from "../../lib/markdown.ts";
import Title from "../Title.astro";

interface Props {
  section: Extract<Section, { type: "rich-text" }>;
  entry: string;
  primary: boolean;
}

const { section, entry } = Astro.props;
const f = sectionFields(entry, section);
const html = await renderMarkdown(section.body, `${entry} section "${section.id}" (rich-text) body`, entry);
---

<section {...f.root} class={sectionClass(section)}>
  <div class="sk-container">
    {
      section.title && (
        <div class="sk-section__header">
          <h2 class="sk-section__title" {...f.field("title")}>
            <Title text={section.title} />
          </h2>
        </div>
      )
    }
    <div class="sk-rich-text__body sk-prose" {...f.field("body")} set:html={html} />
  </div>
</section>
