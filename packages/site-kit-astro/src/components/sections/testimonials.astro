---
// testimonials: title, items (quote, name, role, image + imageAlt). Variants:
// grid (default), single. Tones: surface (default), dark. Single is for one
// featured testimonial or a short stack, each quote shown large. No carousel.
// An item without a photo gets a placeholder part in its place.
import type { Section } from "../../kit-content.ts";
import { sectionFields } from "../../core/field.ts";
import { sectionClass } from "../../lib/hooks.ts";
import SectionHeader from "../SectionHeader.astro";

interface Props {
  section: Extract<Section, { type: "testimonials" }>;
  entry: string;
  primary: boolean;
}

const { section, entry } = Astro.props;
const { title, items } = section;
const f = sectionFields(entry, section);
---

<section {...f.root} class={sectionClass(section)}>
  <div class="sk-container">
    <SectionHeader field={f.field} eyebrow={section.eyebrow} title={title} />
    <ul class="sk-testimonials__list">
      {
        items.map((item, i) => (
          <li>
            <figure class="sk-testimonials__item">
              <blockquote class="sk-testimonials__quote">
                <p {...f.field("items", i, "quote")}>{item.quote}</p>
              </blockquote>
              <figcaption class="sk-testimonials__author">
                {item.image ? (
                  <img src={item.image} alt={item.imageAlt} class="sk-testimonials__avatar" {...f.field("items", i, "image")} />
                ) : (
                  <span class="sk-testimonials__placeholder" aria-hidden="true" />
                )}
                <div class="sk-testimonials__name" {...f.field("items", i, "name")}>
                  {item.name}
                </div>
                {item.role && (
                  <div class="sk-testimonials__role" {...f.field("items", i, "role")}>
                    {item.role}
                  </div>
                )}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
