---
// team: title, intro, items (name, role, image + imageAlt). No variants. A
// member without a photo gets a placeholder part in its place, so a site can
// publish its team before the photos are taken.
import type { Section } from "../../kit-content.ts";
import { sectionFields } from "../../core/field.ts";
import { sectionClass } from "../../lib/hooks.ts";
import SectionHeader from "../SectionHeader.astro";

interface Props {
  section: Extract<Section, { type: "team" }>;
  entry: string;
  primary: boolean;
}

const { section, entry } = Astro.props;
const f = sectionFields(entry, section);
---

<section {...f.root} class={sectionClass(section)}>
  <div class="sk-container">
    <SectionHeader field={f.field} eyebrow={section.eyebrow} title={section.title} intro={section.intro} />
    <ul class="sk-team__list">
      {
        section.items.map((item, i) => (
          <li class="sk-team__member" {...f.item}>
            {item.image ? (
              <img src={item.image} alt={item.imageAlt} class="sk-team__photo" {...f.field("items", i, "image")} />
            ) : (
              <span class="sk-team__placeholder" aria-hidden="true" />
            )}
            <p class="sk-team__name" {...f.field("items", i, "name")}>
              {item.name}
            </p>
            {item.role && (
              <p class="sk-team__role" {...f.field("items", i, "role")}>
                {item.role}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
