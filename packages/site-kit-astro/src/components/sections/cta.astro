---
// cta: eyebrow, title, text, button, secondaryButton. Variants: banner (default), a
// full-width band; card, a box within the page. Tones: accent (default),
// dark, surface. Both buttons are links, the main one first.
import type { Section } from "../../kit-content.ts";
import { sectionFields } from "../../core/field.ts";
import { sectionClass } from "../../lib/hooks.ts";
import SectionHeader from "../SectionHeader.astro";

interface Props {
  section: Extract<Section, { type: "cta" }>;
  entry: string;
  primary: boolean;
}

const { section, entry } = Astro.props;
const { title, text, button, secondaryButton } = section;
const f = sectionFields(entry, section);
---

<section {...f.root} class={sectionClass(section)}>
  <div class="sk-container">
    <SectionHeader field={f.field} eyebrow={section.eyebrow} title={title} intro={text} introProp="text" />
    <div class="sk-buttons">
      <a href={button.link} class="sk-button sk-button--primary" {...f.field("button", "label")}>
        {button.label}
      </a>
      {
        secondaryButton && (
          <a href={secondaryButton.link} class="sk-button sk-button--secondary" {...f.field("secondaryButton", "label")}>
            {secondaryButton.label}
          </a>
        )
      }
    </div>
  </div>
</section>
