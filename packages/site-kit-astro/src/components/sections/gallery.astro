---
// gallery: title, images (image, alt, caption), lightbox. Variants: grid
// (default), masonry. A theme lays out masonry with CSS columns, so images run
// down each column: use grid when their order matters. No carousel.
//
// With `lightbox`, each image links to its file and, with the script, opens
// in a dialog (Lightbox.astro, site-kit-webflow-example design D104). Without
// the script, the link opens the file. Without `lightbox`, images aren't
// links, and the page has no lightbox script.
import type { Section } from "../../kit-content.ts";
import { sectionFields } from "../../core/field.ts";
import { sectionClass } from "../../lib/hooks.ts";
import { localeOfRef } from "../../lib/site-locales.ts";
import Lightbox from "../Lightbox.astro";
import Title from "../Title.astro";

interface Props {
  section: Extract<Section, { type: "gallery" }>;
  entry: string;
  primary: boolean;
}

const { section, entry } = Astro.props;
const { title, images, lightbox } = section;
const f = sectionFields(entry, section);
---

<section {...f.root} class={sectionClass(section)}>
  <div class="sk-container">
    {
      title && (
        <div class="sk-section__header">
          <h2 class="sk-section__title" {...f.field("title")}>
            <Title text={title} />
          </h2>
        </div>
      )
    }
    <ul class="sk-gallery__list">
      {
        images.map((item, i) => (
          <li class="sk-gallery__item">
            <figure>
              {lightbox ? (
                <a href={item.image} class="sk-gallery__link">
                  <img src={item.image} alt={item.alt} loading="lazy" decoding="async" class="sk-gallery__image" {...f.field("images", i, "image")} />
                </a>
              ) : (
                <img src={item.image} alt={item.alt} loading="lazy" decoding="async" class="sk-gallery__image" {...f.field("images", i, "image")} />
              )}
              {item.caption && (
                <figcaption class="sk-gallery__caption" {...f.field("images", i, "caption")}>
                  {item.caption}
                </figcaption>
              )}
            </figure>
          </li>
        ))
      }
    </ul>
    {lightbox && <Lightbox image={images[0].image} alt={images[0].alt!} locale={localeOfRef(entry)?.code} />}
  </div>
</section>
