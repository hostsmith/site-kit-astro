---
// The base layout of every page: SEO head, skip link, header with nav,
// main and footer. All visible text comes from content or settings.
//
// The kit ships no CSS: elements carry the `sk-` hooks listed in HOOKS.md,
// and the site's theme styles them. The stylesheet is the site's
// src/styles/global.css (site-kit-updates design D20).
//
// The layout owns the frame: skip link, landmarks, brand link, main nav,
// menu and breadcrumb. The header's actions and the footer's blocks come
// from settings, so it knows no business facts (site-kit-design-system
// design D35).
//
// The page's locale picks its settings: its nav, blocks and interface
// strings (site-kit-locales design D54). Only a localized site, with more than
// one locale, gets `dir`, alternates and `og:locale` (D51).
import "/src/styles/global.css";
import Breadcrumb from "../components/Breadcrumb.astro";
import EmbedScript from "../components/EmbedScript.astro";
import FooterBlock from "../components/FooterBlock.astro";
import Icon from "../components/Icon.astro";
import LocaleSwitcher from "../components/LocaleSwitcher.astro";
import type { FooterBlock as Block } from "../kit-content.ts";
import { field } from "../core/field.ts";
import { getTranslations, routeOf } from "../lib/routes.ts";
import { absoluteUrl, isNoindexBuild } from "../lib/seo.ts";
import { partUi } from "../lib/part-ui.ts";
import { getSettings, settingsRef } from "../lib/settings.ts";
import { localeOfCode, localeOfPath, localized } from "../lib/site-locales.ts";
import { telHref } from "../lib/tel.ts";
import { plainTitle } from "../lib/title.ts";

interface Props {
  // The document title, as written but for its highlight marks (lib/title.ts).
  title: string;
  description?: string;
  // Public media path of the Open Graph image.
  image?: string;
  // The Open Graph title and description, when they differ from the title
  // and the description, such as from a collection's patterns (lib/patterns.ts).
  ogTitle?: string;
  ogDescription?: string;
  // The page's URL path, such as "/about". Omitted on the 404 page, which
  // has no canonical URL and is never indexed.
  path?: string;
  // The page's locale code. Without it, the locale whose path starts `path`,
  // or the default locale.
  locale?: string;
}

const { description, image, path } = Astro.props;
const title = plainTitle(Astro.props.title);
const locale = Astro.props.locale !== undefined || path === undefined ? localeOfCode(Astro.props.locale) : localeOfPath(path);
const settings = await getSettings(locale?.code);
const SETTINGS = settingsRef(locale?.code);
const home = locale?.path || "/";
const metaDescription = description ?? settings.seo.description;
const ogImage = image ?? settings.seo.ogImage;
const canonical = path === undefined ? undefined : absoluteUrl(path, Astro.site);
const robots = isNoindexBuild() ? "noindex, nofollow" : path === undefined ? "noindex" : undefined;
// A localized page with translations links to each of them, itself included,
// and to the default locale's as x-default (site-kit-locales design D51).
const route = localized && path !== undefined ? await routeOf(path) : undefined;
const translations = route ? await getTranslations(route) : [];
const alternates = translations.length > 1 ? translations : [];
const xDefault = alternates.find((translation) => translation.locale.isDefault);
const ogLocale = (tag: string) => tag.replace("-", "_");
const { logo, nav, ui } = settings;
const actions = settings.header?.actions ?? [];
// The icon-only call button comes from the phone action that sets callLabel.
const call = actions.find((action) => action.type === "phone" && action.callLabel !== undefined);
const hasMenu = nav.length > 0 || actions.length > 0;
// Nested nav items (site-kit-webflow-example design D108): an item with
// children gets a disclosure button, which holds its label, or, when the
// item has a link of its own, sits beside the link, named by ui.navSubmenu.
const submenus = nav.some((item) => item.children);
const submenuName = nav.some((item) => item.children && item.link)
  ? await partUi(locale?.code, "nav item with a link and children", ["navSubmenu"])
  : undefined;

// footer.blocks in groups: each block starts one unless it sets withPrevious.
const groups: { block: Block; index: number }[][] = [];
(settings.footer?.blocks ?? []).forEach((block, index) => {
  if (block.withPrevious && groups.length > 0) groups.at(-1)!.push({ block, index });
  else groups.push([{ block, index }]);
});
const bottom = settings.footer?.bottom ?? [];

// The page's content, rendered before the head, so the layout adds a part's
// script only when the content uses it (site-kit-webflow-example design D104):
// the reveal script for an element with `data-reveal`, and the embed script
// for a placeholder, such as a video link's in a Markdown body.
const content = await Astro.slots.render("default");
const reveal = / data-reveal="/.test(content);
const embeds = content.includes('class="sk-embed__placeholder"');
---

<!doctype html>
<html lang={settings.language} dir={localized ? locale?.dir : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={Astro.props.ogTitle ?? title} />
    <meta property="og:description" content={Astro.props.ogDescription ?? metaDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={absoluteUrl(ogImage, Astro.site)} />}
    {localized && <meta property="og:locale" content={ogLocale(settings.language)} />}
    {
      alternates
        .filter((translation) => translation.locale.code !== locale?.code)
        .map((translation) => <meta property="og:locale:alternate" content={ogLocale(translation.locale.tag)} />)
    }
    {alternates.map((translation) => <link rel="alternate" hreflang={translation.locale.tag} href={absoluteUrl(translation.path, Astro.site)} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefault.path, Astro.site)} />}
    {
      /*
        Reveal (site-kit-webflow-example design D104): runs before the page
        renders and sets `data-sk-ready` on <html>, so a theme can hide a reveal
        element under it without a flash. Then it sets `data-revealed` on each
        element with `data-reveal` once it enters the viewport. A theme animates
        on that, only without reduced motion. Without scripts, nothing is hidden.
      */
      reveal && (
        <script is:inline>
          (() => {
            document.documentElement.setAttribute("data-sk-ready", "");
            const start = () => {
              const elements = document.querySelectorAll("[data-reveal]");
              if (!("IntersectionObserver" in window)) {
                elements.forEach((element) => element.setAttribute("data-revealed", ""));
                return;
              }
              const observer = new IntersectionObserver(
                (entries) => {
                  for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    entry.target.setAttribute("data-revealed", "");
                    observer.unobserve(entry.target);
                  }
                },
                { rootMargin: "0px 0px -10% 0px" },
              );
              elements.forEach((element) => observer.observe(element));
            };
            if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start);
            else start();
          })();
        </script>
      )
    }
  </head>
  <body>
    <a href="#main" class="sk-skip-link" {...field(SETTINGS, "ui", "skipLink")}>{ui.skipLink}</a>

    <header class="sk-header">
      <div class="sk-container">
        <a href={home} class="sk-header__brand">
          {
            logo ? (
              <img src={logo.image} alt={logo.alt} class="sk-header__logo" {...field(SETTINGS, "logo", "image")} />
            ) : (
              <span class="sk-header__name" {...field(SETTINGS, "name")}>
                {settings.name}
              </span>
            )
          }
        </a>
        {
          call?.type === "phone" && (
            <a href={telHref(call.number)} class="sk-header__call" aria-label={`${call.callLabel} ${call.number}`}>
              <Icon name="phone" />
            </a>
          )
        }
        {
          hasMenu && (
            <>
              <button type="button" hidden aria-expanded="false" aria-controls="sk-menu" class="sk-header__menu-button">
                <Icon name="menu" />
                <Icon name="x" />
                <span class="sk-header__menu-label" {...field(SETTINGS, "ui", "menu")}>
                  {ui.menu}
                </span>
              </button>
              {/* The menu is rendered once: the theme lays it out as a row on wide screens and as a panel on narrow ones. */}
              <div id="sk-menu" class="sk-menu">
                {nav.length > 0 && (
                  <nav class="sk-nav" aria-label={ui.mainNav}>
                    <ul class="sk-nav__list">
                      {nav.map((item, i) =>
                        item.children ? (
                          <li class="sk-nav__item">
                            {item.link ? (
                              <>
                                <a href={item.link} aria-current={item.link === path ? "page" : undefined} class="sk-nav__link" {...field(SETTINGS, "nav", i, "label")}>
                                  {item.label}
                                </a>
                                <button
                                  type="button"
                                  class="sk-nav__toggle"
                                  aria-expanded="true"
                                  aria-controls={`sk-submenu-${i}`}
                                  aria-label={submenuName!("navSubmenu", { label: item.label })}
                                  data-current={item.children.some((child) => child.link === path) ? "" : undefined}
                                  hidden
                                >
                                  <Icon name="chevron-down" />
                                </button>
                              </>
                            ) : (
                              <button
                                type="button"
                                class="sk-nav__toggle"
                                aria-expanded="true"
                                aria-controls={`sk-submenu-${i}`}
                                data-current={item.children.some((child) => child.link === path) ? "" : undefined}
                              >
                                <span {...field(SETTINGS, "nav", i, "label")}>{item.label}</span>
                                <Icon name="chevron-down" />
                              </button>
                            )}
                            <ul id={`sk-submenu-${i}`} class="sk-nav__submenu">
                              {item.children.map((child, j) => (
                                <li>
                                  <a
                                    href={child.link}
                                    aria-current={child.link === path ? "page" : undefined}
                                    class="sk-nav__sublink"
                                    {...field(SETTINGS, "nav", i, "children", j, "label")}
                                  >
                                    {child.label}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </li>
                        ) : (
                          <li>
                            <a
                              href={item.link}
                              aria-current={item.link === path ? "page" : undefined}
                              class="sk-nav__link"
                              {...field(SETTINGS, "nav", i, "label")}
                            >
                              {item.label}
                            </a>
                          </li>
                        ),
                      )}
                    </ul>
                  </nav>
                )}
                {actions.length > 0 && (
                  <div class="sk-header__actions">
                    {actions.map((action, i) =>
                      action.type === "phone" ? (
                        <a href={telHref(action.number)} class="sk-header__phone" {...field(SETTINGS, "header", "actions", i, "number")}>
                          {action.number}
                        </a>
                      ) : action.type === "button" ? (
                        <a href={action.link} class={`sk-button sk-button--${action.style}`} {...field(SETTINGS, "header", "actions", i, "label")}>
                          {action.label}
                        </a>
                      ) : action.type === "locales" ? (
                        <LocaleSwitcher path={path} locale={locale?.code} />
                      ) : (
                        <a href={action.link} class="sk-header__link" {...field(SETTINGS, "header", "actions", i, "label")}>
                          {action.label}
                        </a>
                      ),
                    )}
                  </div>
                )}
              </div>
              {/*
                Runs during parsing, so a theme's closed menu never flashes open. It
                reveals the menu button and marks the menu `data-ready`; `data-open`
                marks it open. A theme hides the menu only while it is
                `[data-ready]:not([data-open])`, so without JavaScript it stays usable.
              */}
              <script is:inline>
                (() => {
                  const button = document.querySelector(".sk-header__menu-button");
                  const menu = document.getElementById("sk-menu");
                  const setOpen = (open) => {
                    button.setAttribute("aria-expanded", String(open));
                    menu.toggleAttribute("data-open", open);
                  };
                  button.hidden = false;
                  menu.setAttribute("data-ready", "");
                  button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
                  document.addEventListener("keydown", (event) => {
                    if (event.key === "Escape" && button.getAttribute("aria-expanded") === "true") {
                      setOpen(false);
                      button.focus();
                    }
                  });
                })();
              </script>
              {/*
                Nested nav items: each item with children closes its list and marks
                itself `data-ready`; `data-open` marks it open. A theme collapses a
                list only while its item is `[data-ready]:not([data-open])`. Escape,
                a click outside or focus leaving the item closes it.
              */}
              {submenus && (
                <script is:inline>
                  (() => {
                    for (const item of document.querySelectorAll(".sk-nav__item")) {
                      const button = item.querySelector(".sk-nav__toggle");
                      const setOpen = (open) => {
                        button.setAttribute("aria-expanded", String(open));
                        item.toggleAttribute("data-open", open);
                      };
                      button.hidden = false;
                      setOpen(false);
                      item.setAttribute("data-ready", "");
                      button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
                      item.addEventListener("keydown", (event) => {
                        if (event.key !== "Escape" || button.getAttribute("aria-expanded") !== "true") return;
                        event.stopPropagation();
                        setOpen(false);
                        button.focus();
                      });
                      item.addEventListener("focusout", (event) => {
                        if (!item.contains(event.relatedTarget)) setOpen(false);
                      });
                      document.addEventListener("click", (event) => {
                        if (!item.contains(event.target)) setOpen(false);
                      });
                    }
                  })();
                </script>
              )}
            </>
          )
        }
      </div>
    </header>

    <main id="main" tabindex="-1" class="sk-main">
      {path && <Breadcrumb path={path} locale={locale?.code} />}
      <Fragment set:html={content} />
      {embeds && <EmbedScript />}
    </main>

    {
      (groups.length > 0 || bottom.length > 0) && (
        <footer class="sk-footer">
          <div class="sk-container">
            {groups.map((group) => (
              <div class="sk-footer__group">
                {group.map(({ block, index }) => (
                  <FooterBlock block={block} path={["footer", "blocks", index]} id={`sk-footer-block-${index}`} locale={locale?.code} pagePath={path} />
                ))}
              </div>
            ))}
            {bottom.length > 0 && (
              <div class="sk-footer__bottom">
                {bottom.map((block, index) => (
                  <FooterBlock block={block} path={["footer", "bottom", index]} id={`sk-footer-bottom-${index}`} locale={locale?.code} pagePath={path} />
                ))}
              </div>
            )}
          </div>
        </footer>
      )
    }
  </body>
</html>
