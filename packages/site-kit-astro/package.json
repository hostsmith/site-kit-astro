{
  "name": "@hostsmith/site-kit-astro",
  "version": "0.14.0",
  "description": "A reusable kit for building websites with Astro: typed sections in Markdown, header and footer blocks, guidelines for AI agents and example designs, with a deploy workflow for Hostsmith.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/hostsmith/site-kit-astro#readme",
  "bugs": {
    "url": "https://github.com/hostsmith/site-kit-astro/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hostsmith/site-kit-astro.git",
    "directory": "packages/site-kit-astro"
  },
  "keywords": [
    "astro-integration",
    "withastro",
    "webflow",
    "hostsmith"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./index.ts",
    "./core": "./core.ts",
    "./copy": "./src/core/copy.ts",
    "./content": "./src/content.ts",
    "./schema": "./src/lib/schema.ts",
    "./field": "./src/core/field.ts",
    "./markdown": "./src/lib/markdown.ts",
    "./settings": "./src/lib/settings.ts",
    "./routes": "./src/lib/routes.ts",
    "./custom-page": "./src/lib/custom-page.ts",
    "./ui": "./src/lib/ui.ts",
    "./locales": "./src/lib/localize.ts",
    "./title": "./src/lib/title.ts",
    "./components/Sections.astro": "./src/components/Sections.astro",
    "./components/Title.astro": "./src/components/Title.astro",
    "./layouts/Base.astro": "./src/layouts/Base.astro"
  },
  "bin": {
    "site-kit": "bin/site-kit.mjs"
  },
  "files": [
    "index.ts",
    "core.ts",
    "virtual.d.ts",
    "src",
    "scripts",
    "bin",
    "decap",
    "skills",
    "AGENTS.md",
    "HOOKS.md"
  ],
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "@hostsmith/sdk": "1.4.0",
    "devalue": "5.9.4",
    "ultrahtml": "1.7.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "astro": "^7.3.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
