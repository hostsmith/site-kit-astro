---
// Detail template of the news collection: one entry at <base path>/<slug>.
import { field } from "@hostsmith/site-kit-astro/field";
import { assertNoH1 } from "@hostsmith/site-kit-astro/markdown";
import { getSettings } from "@hostsmith/site-kit-astro/settings";
import { render, type CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"news">;
}

const { entry } = Astro.props;
const { title, date, image, imageAlt } = entry.data;
const ref = `news/${entry.id}`;
const settings = await getSettings();
const { Content, headings } = await render(entry);
assertNoH1(headings, entry.filePath ?? ref);
const dateFormat = new Intl.DateTimeFormat(settings.language, { dateStyle: "long", timeZone: "UTC" });
---

<article>
  <h1 {...field(ref, "title")}>{title}</h1>
  <time datetime={date} {...field(ref, "date")}>{dateFormat.format(new Date(date))}</time>
  {image && <img src={image} alt={imageAlt} {...field(ref, "image")} />}
  <div class="sk-prose" {...field(ref, "body")}>
    <Content />
  </div>
</article>
