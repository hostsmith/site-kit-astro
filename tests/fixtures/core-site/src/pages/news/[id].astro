---
import { getCollection, render } from "astro:content";
import { fieldsFor } from "@hostsmith/site-kit-astro/field";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  return (await getCollection("news")).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const f = fieldsFor("news", entry.id);
---

<BaseLayout title={entry.data.title}>
  <article>
    <h1 {...f("title")}>{entry.data.title}</h1>
    <p>
      <time datetime={entry.data.date} {...f("date")}>{entry.data.date}</time>
      <span {...f("category")}>{entry.data.category}</span>
    </p>
    {entry.data.image && <img src={entry.data.image} alt="" {...f("image")} />}
    <div {...f("body")}><Content /></div>
  </article>
</BaseLayout>
