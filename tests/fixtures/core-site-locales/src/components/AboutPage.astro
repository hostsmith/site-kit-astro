---
import { copy } from "../content.config.ts";
import BaseLayout from "../layouts/BaseLayout.astro";

const locale = Astro.currentLocale;
const about = await copy.get("about", locale);
const f = copy.fields("about", locale);
---

<BaseLayout title={about.title}>
  <h1 {...f("title")}>{about.title}</h1>
  <p {...f("intro")}>{about.intro}</p>
</BaseLayout>
