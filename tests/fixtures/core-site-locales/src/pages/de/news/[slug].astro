---
import { getCollection } from "astro:content";
import NewsArticle from "../../../components/NewsArticle.astro";

export async function getStaticPaths() {
  const news = await getCollection("news", (entry) => entry.id.startsWith("de/"));
  return news.map((entry) => ({ params: { slug: entry.id.slice("de/".length) }, props: { entry } }));
}
---

<NewsArticle entry={Astro.props.entry} />
